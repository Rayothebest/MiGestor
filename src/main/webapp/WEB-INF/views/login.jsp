<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Ingresar | MiGestor</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/app.css"></head>
<body class="auth-page"><main class="auth-card"><div class="brand">MiGestor</div><h1>Bienvenido</h1><p class="muted">Administra tu negocio a tu manera.</p><c:if test="${not empty error}"><div class="flash error"><c:out value="${error}"/></div></c:if>
<form method="post" action="${pageContext.request.contextPath}/login"><label>Correo<input type="email" name="email" required autocomplete="email"></label><label>Contraseña<input type="password" name="password" required autocomplete="current-password"></label><button class="primary" type="submit">Ingresar</button></form><p>¿Aún no tienes cuenta? <a href="${pageContext.request.contextPath}/register">Crear negocio</a></p></main></body></html>
