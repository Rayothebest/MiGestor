<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Crear cuenta | MiGestor</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/app.css"></head>
<body class="auth-page"><main class="auth-card"><div class="brand">MiGestor</div><h1>Crea tu espacio</h1><p class="muted">Tus módulos y datos quedarán separados de otros negocios.</p><c:if test="${not empty error}"><div class="flash error"><c:out value="${error}"/></div></c:if>
<form method="post" action="${pageContext.request.contextPath}/register"><label>Tu nombre<input name="name" required maxlength="100"></label><label>Nombre del negocio<input name="business" required maxlength="120"></label><label>Correo<input type="email" name="email" required maxlength="190"></label><label>Contraseña<input type="password" name="password" required minlength="8"></label><button class="primary" type="submit">Crear cuenta</button></form><p><a href="${pageContext.request.contextPath}/login">Volver al inicio de sesión</a></p></main></body></html>
